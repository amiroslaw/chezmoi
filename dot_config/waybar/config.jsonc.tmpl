// killall -SIGUSR2 waybar
// or pkill -SIGUSR2 waybar
{{ if eq .chezmoi.hostname "pc" }}
[{
	"output": "DVI-D-1",
    "layer": "top",
    "position": "top",
    "mod": "dock",
    "exclusive": true,
    "passthrough": false,
    "gtk-layer-shell": true,
    "height": 28,
    "margin-right": 5,
    "margin-left": 5, 
	"include": [ "~/.config/waybar/modules.jsonc", ],
    "modules-left": [
        "custom/rofi",
        // "custom/khorshididate",
        // "wlr/taskbar",
        "hyprland/workspaces",
		"hyprland/windowcount",
		"hyprland/submap",
    ],
    "modules-center": [
        "hyprland/window",
    ],
    "modules-right": [
        "tray",
		"mpris",
		"custom/zypper",
		"custom/mega",
        "pulseaudio/slider",
        "pulseaudio#microphone",
		"custom/pomodoro",
		"custom/web-cal",
        "clock",
        "memory",
		"custom/weather",
        "cpu",
        "disk",
        "temperature",
        "group/power"
    ]},
	{
	"output": "DVI-I-1",
    "layer": "top",
    "position": "top",
    "mod": "dock",
    "exclusive": true,
    "passthrough": false,
    "gtk-layer-shell": true,
    "height": 28,
    "margin-right": 5,
    "margin-left": 5, 
	"include": [ "~/.config/waybar/modules.jsonc"],
    "modules-left": [
        "hyprland/workspaces",
		"hyprland/windowcount",
		"hyprland/submap",
    ],
    "modules-center": [
		"mpd",
    ],
    "modules-right": [
        "pulseaudio",
		"custom/web-cal",
        "clock",
        "group/power"
    ],
	}]
{{ else if eq .chezmoi.hostname "laptop" }}

