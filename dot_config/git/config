	email = arek47@gmail.com
[core]
    pager = delta --side-by-side
	; pager = difftool | less
	autocrlf = input
	editor = nvim

[pull]
  rebase = true
# sort by newer
[branch]
  sort = -committerdate
# [push]
  # autoSetupRemote = true
# does git push --set-upstream origin <nazwa-gałęzi>
# deletes local branch if it doesn't exist on the server 
# [fetch]
  # prune = true
[rerere]
# Git remembers how you solved the conflict last time.
  enabled = true
# adds to the staging area (git add
	# autoupdate = true
[difftool]
  prompt = false
[diff]
	tool = diffview
[merge]
	tool = diffview
; for orgi file
	keepBackup = true
[interactive]
    diffFilter = delta --color-only
[difftool "meld"]
    cmd = meld "$LOCAL" "$REMOTE"
[mergetool "meld"]
	cmd = meld --auto-merge "$LOCAL" "$BASE" "$REMOTE" --output "$MERGED"
	trustExitCode = true
[difftool "diffview"]
	cmd = nvim -c \"DiffviewOpen\"
[mergetool "diffview"]
	cmd = nvim -c \"DiffviewOpen\"
[difftool "nvimdiff"]
	cmd = "nvim -d \"$LOCAL\" \"$REMOTE\""
[mergetool "nvimdiff"]
    cmd = nvim -d $LOCAL $REMOTE $MERGED -c '$wincmd w' -c 'wincmd J'
[mergetool "nvimtabs"]
	layout = BASE,MERGED + BASE,LOCAL + BASE, REMOTE
[difftool "difftastic"]
; https://difftastic.wilfred.me.uk/git.html
	cmd = difft "$LOCAL" "$REMOTE"
# [pager]
	# difftool = true
[alias]
	showext = show --ext-diff
# `git dft` is less to type than `git difftool`.
[alias]
	dft = difftool

# vim: ft=cfg
