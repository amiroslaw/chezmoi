% shortcuts
@ util

# chezmoi apply source
chezmoi apply --source-path <chezmoi-files>

# chezmoi apply
chezmoi apply --include <type> <force>
$ chezmoi-files: fd -t f ~/.local/share/chezmoi/
$ type: echo "files\nall"
$ force: echo " \n--force"

# wormhole receive
wormhole receive

# wormhole send 
wormhole send <text> <file>

$ text: echo " \n--text"

# gnucash
WEBKIT_DISABLE_COMPOSITING_MODE=1 gnucash

# image preview 
timg -U --grid=<int> --title --center --clear -p <pixelation> <files>
$ pixelation: echo -e "kitty\nsixel\nhalf"

# hard remove/prune files
gomi --prune <duration>
$ duration: echo -e "1d\n1w\n1m"

# pueue log failed jobs
pueue log -afj | fx 'Object.values(this).filter(x => x.task?.status?.Done?.result?.Failed).map(x => `${x.task.id}: ${x.task.label}\n${x.task.command}\n${x.output}`).join("\n")'

# pueue log a group
pueue log -g <groups>
$ groups: pueue group -j | fx 'Object.keys(this).join("\n")'

# start gemini
npx https://github.com/google-gemini/gemini-cli

# qr code -provide content or select clipboard
eval "<clip>" | qrencode -t UTF8
$ clip-op: echo -e "clip\nselect"
$ clip:  bb -o '(case "<clip-op>" "clip" "clipcat.clj clip" "select" "clipcat.clj primary" "echo <clip-op>")'
# $ clip:  bb -o '(case "<clip-op>" "clip" "clipster -oc" "select" "clipster -op" "echo <clip-op>")'
# echo 'qrencode -t UTF8 "$(<clip>)"'
#
# echo <content> | curl -F-=\<- qrenco.de

# ffmpeg increase volume; double around 2-3
ffmpeg -i <file> -af "speechnorm,volume=<double>" "<base>-loud.<ext>"

$ file: find . -maxdepth 1 -type f 
$ base: basename <file> .<ext>
# split filename and extention
$ ext:  bb -o '(str/trim (last (str/split "<file>" #"\.")))'
# $ file: find . -maxdepth 1 -type f --- --expand
# $ ext: echo "<file>" | bb -o '(str/trim (last (str/split (slurp *in*) #"\.")))'
# $ ext: echo "<file>" | awk -F. '{print $NF}' # doesn't trim
