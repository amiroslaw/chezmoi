% zypper
@ util
## TODO add autofill for remove, info 

# Install packages 
sudo zypper install --auto-agree-with-licenses <recommends> <confirm> <package-name>

# Install packages fzf ::zyins
sudo zypper install --auto-agree-with-licenses <recommends> <confirm> <search> 

# Install local rpm package
sudo zypper install <files>

# Download package without installing
sudo zypper install --download-only <package-name>

# Downgrade or install a package with a specific version
sudo zypper install --force <package-name>-<package-version>

# Remove user package fzf ::zyres
sudo zypper --no-refresh remove <deps> <confirm> <installed-fzf-system>
# Remove system package fzf ::zyreu
sudo zypper --no-refresh remove <deps> <confirm> <installed-fzf-user>

# Search packages ::zyser
zypper --no-refresh search <installed> <type> <query>
# dependencis list all packages depended on the package
zypper --no-refresh search --requires --recommends --installed-only <package-name>
# there is also --requires-pkg

# Show full information for specified packages ::zyifs
zypper -q --no-refresh info --requires --recommends --suggests --provides <installed-fzf-system>

# Show full information for user installed packages ::zyifu
zypper -q --no-refresh info --requires --recommends --suggests --provides <installed-fzf-user>

# List packages
zypper --no-refresh packages <installed-pa>
# List packages orphaned
zypper --no-refresh packages --orphaned
# List packages unneeded
zypper --no-refresh packages --unneeded
# List all packages from the  repo
zypper --no-refresh packages <installed-pa> <repo-name>

# Update packages
sudo env ZYPP_PCK_PRELOAD=1 zypper update

# Only download the packages, do not install
sudo zypper update --download-only 

# List available updates
zypper list-updates

# Update specific package
sudo zypper update <package-name>

# Perform a distribution upgrade
sudo zypper dist-upgrade

# Clean up all local caches
zypper clean

# Clean both metadata and package caches
zypper clean --all

# add repository
sudo zypper addrepo <repo>

# Start a shell to enter multiple commands in one session
sudo zypper shell

$ recommends: echo ' \n--no-recommends'
$ deps: echo '--clean-deps\n '
$ confirm: echo ' \n--no-confirm'
$ installed: echo ' \n--installed-only'
$ installed-pa: echo ' \n--installed-only\n--userinstalled\n--system'
$ type: echo ' \n--requires\n--provides\n--file-list' 
$ installed-fzf-system: rpm -qa --qf "%{NAME}\n" | sort
# $ installed-fzf-system: zypper --no-refresh -q search --installed-only | awk 'BEGIN { FS="|"}  {print $2}'
$ installed-fzf-user: zypper --no-refresh -q packages --userinstalled | awk 'BEGIN { FS="|" } NR >2 {print $3}' | awk '!seen[$0]++'
$ search: echo <search-desc> | awk '{print $1}' 
$ search-desc: zypper -q search --not-installed-only | awk 'BEGIN { FS="|" } NR >2 {print $2 $3}' 
