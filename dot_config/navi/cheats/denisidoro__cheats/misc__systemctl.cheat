% systemctl, service

# shutdown ::shutd
sleep <timer> && systemctl poweroff
$ timer-op: echo '15 min\n30 min\n45 min\n60 min'
$ timer:  bb -i '(case "<timer-op>" "15 min" "900" "30 min" "1800" "45 min" "2700" "60 min" "3600" (str (* <timer-op> 60)))'

# start service
systemctl <user> start <service_inactive>

# Stop service ::sdsto
systemctl <user> stop <service_active>

# Enable service ::sdena
systemctl <user> enable <service_disabled>

# Disable service
systemctl <user> disable <service_enabled>

# Restart service ::sdres
systemctl <user> restart <service>

# Reload service
systemctl <user> reload <service_active>

# Service status ::sdsta
systemctl <user> status <service>

# List running services
systemctl <user> list-units --type=service --state=running

# List services ; empty state will list all services, without running
systemctl <user> list-unit-files --type=service <state> 

# reload daemon ::sdrel
systemctl <user> daemon-reload

# cat print config
journalctl <user> cat <service_system> 

# log service
journalctl <user> <level> -u <service_system> <lines> 
# log service user
journalctl --user <level> -u <service_user> <lines>
$ user: echo ' \n--user'
$ level: echo ' \n-p err \n-p warning \n-p notice \n-p debug'

# it doesn't list all eg. xdg-desktop-portal-hyprland 
$ service_system: systemctl <user> list-unit-files --type=service --all | awk '{print $1}' | grep .service | sed 's/.service$//'
# I can remove that
$ service_user: systemctl --user list-unit-files --type=service --all  | awk '{print $1}' | grep .service | sed 's/.service$//'
$ service_inactive: systemctl <user> list-unit-files --type=service --state=inactive | awk '{print $1}' | grep .service | sed 's/.service$//'
$ service_active: systemctl <user> list-units --type=service --state=active | awk '{print $1}' | grep .service | sed 's/.service$//'
$ service_enabled: systemctl <user> list-unit-files --type=service --state=enabled | awk '{print $1}' | grep .service | sed 's/.service$//'
$ service_disabled: systemctl <user> list-unit-files --type=service --state=disabled | awk '{print $1}' | grep .service | sed 's/.service$//'
$ service: systemctl <user> list-unit-files --type=service --all | awk '{print $1}' | grep .service | sed 's/.service$//'

$ state: echo ' \n--state=enabled\n--state=disabled'
$ lines: echo '--boot\n--follow\n--all'
$ service_all: systemctl list-units --type=service --all && systemctl --user list-units --type=service --all  | awk '{print $1}' | grep .service | sed 's/.service$//'
# maybe add 
$ output: echo 'short\ncat\njson'
