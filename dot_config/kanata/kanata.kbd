comment
|#

(defcfg
	linux-dev (/dev/input/by-id/usb-Microsoft_Microsoft®_2.4GHz_Transceiver_v9.0-event-kbd /dev/input/by-path/platform-i8042-serio-0-event-kbd)
	process-unmapped-keys yes
	danger-enable-cmd yes
	concurrent-tap-hold yes ;; enables defchordsv2 
	sequence-timeout 2000
)

(defsrc
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt cmp rctl
)

(deflayer base
  @grv  @1    @2    @3    @4    @5    @6    @7    @8    @9    @0    @-    @=    bspc
  @tab  q    w     e    r    t    y    u    i    o    p    [    ]    \
  @cap  @alt_a   @met_s	@ctl_d @sft_f g	h @sft_j  @ctl_k @met_l @alt_; '    ret
  @lsft z    x    @c    v    b    n    m    ,    .    /    @rsft
  lctl lmet @lalt           @spc            @ralt cmp lmet
) ;; doubled lmet

(deflayer numbers
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    1    2    3    4    5    6    7    8    9    0    -    =    bspc
  _    S-4    S-=    S-9  S-0    S-2    S-\    -    =      S--    S-8    '    ret
  _    S-1    S-3    S-[  S-]    S-`    S-7    [    ]    S-5    S-6    _
  _    _    _              _              _    _    _ 
)
;; _    $    +    \(    \)    @    |    -    =    \_    *    '    ret
;; _    !    #    {    }    ~    &    [    ]    %    ^    @mdf

(deftemplate hold (tap hold)
  (tap-hold 200 200 $tap $hold)
)
(defalias ;; symbols on hold
  grv (t! hold grv S-`)
  0 (t! hold 0 S-0)
  1 (t! hold 1 S-1)
  2 (t! hold 2 S-2)
  3 (t! hold 3 S-3)
  4 (t! hold 4 S-4)
  5 (t! hold 5 S-5)
  6 (t! hold 6 S-6)
  7 (t! hold 7 S-7)
  8 (t! hold 8 S-8)
  9 (t! hold 9 S-9)
  = (t! hold = S-=)
  - (t! hold - S--))

(deflayer navigation ;; plus media
  XX    XX    XX    XX    XX    XX    XX    XX    XX    XX    XX    XX    XX    XX
  XX    XX    XX    XX    XX    XX    C-c   C-z	C-x   C-v  S-ins  XX    XX   XX
  XX    mute    vold  volu	XX    XX    left down   up   rght   ret   XX    XX    
  XX    XX    XX    XX    XX    XX    home	pgdn pgup	end	  ins   XX
  XX    XX    XX              XX              XX    XX    XX 
)
;; S-ins; C-z: pase select, undo

(defalias ;; layers
  ;; lcrt (tap-hold-release 200 200 sldr lcrt)
  lsft (tap-hold-press 200 200 bspc lsft) ;;  left backspace
  rsft (tap-hold-press 200 200 S-0 rsft) ;; right bracket
  ;;grv (tap-hold 200 200 grv lrld) ;; reload on hold
  cap (tap-hold-press 200 200 esc (layer-while-held navigation)) ;; esc
  spc (tap-hold 200 200 spc (layer-while-held numbers))
  pl (one-shot 500 (layer-while-held pl))
  ralt (tap-hold-release 200 200 @pl ralt) ;; TODO maybe double pl layer and make actions on hold
  apps (one-shot 500 (layer-while-held apps))
  lalt (tap-hold-release 200 200 @apps lalt)
 ;; enter (switch  ((and u i)) ret break)
  ;; spc (one-shot 500 (layer-while-held numbers))
)

;; HOMEROW
(defalias
	alt_a (tap-hold 200 200 a lalt)
    met_s (tap-hold 200 200 s lmet)
    ctl_d (tap-hold 200 200 d lctl)
    sft_f (tap-hold 200 200 f lsft)
;; right hand
    sft_j (tap-hold 200 200 j rsft)
    ctl_k (tap-hold 200 200 k rctl)
    met_l (tap-hold 200 200 l rmet)
    alt_; (tap-hold 200 200 ; lalt)
)

(defchordsv2 ;; can be only one
  (h j) ret 100 first-release () ;; enter on j+k
  ;; with homerow it has to be repeated 
  ;;(lmet v) (cmd clipcat.clj menu --paste) 800 first-release ()
  ;;(lmet lctl v) (cmd clipcat.clj previous --paste) 800 first-release ()
  ;;(lmet lsft v) (cmd clipcat.clj selection --paste) 800 first-release ()
  ;;(l v) (cmd clipcat.clj menu --paste) 800 first-release ()
  ;;(l k v) (cmd clipcat.clj previous --paste) 800 first-release ()
  ;;(l j v) (cmd clipcat.clj selection --paste) 800 first-release ()
)

(deflayer pl
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    (macro RA-e)    lrld    _    _    _    _    (macro RA-o)    _    _    _    _
  _    (macro RA-a)    (macro RA-s)    _    _    _	_    _    _    (macro RA-l)    _    _    _
  _    (macro RA-z)    (macro RA-x)    (macro RA-c)  _    _    (macro RA-n)    _    _    _ _    _
  _    _    _              _              _    _    _ 
)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;                  APPLICATIONS                  ;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(deflayer apps
  XX    XX    XX    XX    XX    XX    XX    XX    XX    XX    XX    XX    XX    XX
  XX    @q    XX    @news    XX    @tw    @yt    XX    @qb    XX    @fm    XX    XX    XX
  XX    @audio @off @rofi @vifm    XX    @clip    @chat @kee     @qu   XX    XX    XX
  XX    @todo  @pom  @idea    @video    XX    @note    XX    XX    XX    XX    XX
  XX    XX    ret              XX              XX    XX    XX
)

(defalias ;; common apps scripts
  tab (tap-dance 300 (tab M-tab  A-tab C-tab)) ;; too many available actions
  q (cmd notify-send t)
  trash (cmd sh -c r#"eval $(printf "$TERM_LT $TERM_LT_RUN" "trash" "gomi --restore")"#r) ;; TODO add
  ;; without setsid or sh -c, apps will be terminated when kanata is killed
	rofi(cmd rofi -modi drun,keys,run -show drun -show-icons -sidebar-mode -monitor -4 -matching fuzzy)

  qu (cmd qu.clj menu)
  yt (cmd setsid mpv.lua -o)
  qb (cmd sh -c "$XDG_CONFIG_HOME/qutebrowser/userscripts/session.sh")
  pom (cmd sh -c "task sync && pomodoro.lua add -n")
  note (cmd setsid wezterm start --class note --cwd /home/miro/Documents/notebook -- nvim)
  idea (cmd setsid /home/miro/Ext/idea-IU-233.14015.106/bin/idea.sh)
  vifm (cmd setsid xst -c vifm -e vifm)
  chat (cmd setsid scratchpad.sh chat "wezterm start --class chat -- nchat")
  audio (cmd audio.sh toggle)
  clip (cmd "/home/miro/.config/rofi/scripts/clipster/roficlip" )
  off (cmd rofi -show power-menu -modi power-menu:~/.config/rofi/scripts/power.sh)
  news (cmd setsid scratchpad.sh newsboat "wezterm start --class newsboat -- newsboat")
  tw (cmd setsid scratchpad.sh task "foot -T task --app-id task -e taskwarrior-tui")
  kee (cmd setsid keecli.sh)
  video (cmd setsid mpv.lua -o /home/miro/Videos)
  todo (cmd todo.lua add)
  fm (cmd setsid pcmanfm )
  ;; scripts (cmd sh -c "$(ls ~/.bin | rofi -dmenu)")
)

(deflayermap (clip)
  p (cmd clipcat.clj selection --paste)
  j (cmd clipcat.clj join --input)
  4 (cmd clipcat.clj join --number 4)
  m (cmd clipcat.clj menu --paste)
  r (cmd clipcat-menu remove)
  ;;e (cmd bash -c "clipcat-menu edit") ;; idk why but it doesn't work
  n (cmd clipcat.clj previous --paste)
  F1 (cmd notify-send deflayermap)
  ___ XX
)

(defalias ;; clipboard
  clipboard (one-shot 800 (layer-while-held clip))
  ;;ralt (layer-switch script)
  c (tap-hold 200 200 c @clipboard)
  ;;c (tap-hold 200 200 c (cmd notify-send 1))
  )


