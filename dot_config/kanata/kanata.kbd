remove pl layer if not many bindings
maybe all cmd move to aliases and only refer to them in deflayermap/layer - better readebility and more space for custom helper script - parser 
look if some programs need to be execute with shell
	;;w (cmd sh -c "note.lua write")
|#

(defcfg
	linux-dev (/dev/input/by-id/usb-Microsoft_Microsoft®_2.4GHz_Transceiver_v9.0-event-kbd /dev/input/by-path/platform-i8042-serio-0-event-kbd)
	process-unmapped-keys yes
	danger-enable-cmd yes
	concurrent-tap-hold yes ;; enables defchordsv2 
	sequence-timeout 2000
)

(deftemplate hold (tap hold)
  (tap-hold 200 300 $tap $hold)
)

(defsrc
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt cmp rctl
)

(deflayer base
  @grv  @1    @2    @3    @4    @5    @6    @7    @8    @9    @0    @-    @=    bspc
  @tab  q    w     e    r    t    y    @u    @i    @o    p    [    ]    \
  @cap  @alt_a   @met_s	@ctl_d @sft_f g	h @sft_j  @ctl_k @met_l @alt_; '    ret
  @lsft @z    x    @c    v    b    n    @m    ,    .    /    @rsft
  lctl lmet @lalt           @spc            ralt cmp lmet
) ;; doubled lmet

(deflayer apps
  XX    XX    XX    XX    XX    XX    XX    XX    XX    XX    XX    XX    XX    @trash
  XX    @quake    XX    @news    XX    @tw    @yt    XX    @qb    XX    @fm    XX    XX    XX
  XX    @audio @off @rofi @vifm    XX    @clip    @chat @kee     @qu   XX    XX    XX
  XX    @todo  @pom  @idea    @video    XX    @note    XX    XX    XX    XX    XX
  XX    XX    ret              XX              XX    XX    XX
)

(deflayer pl
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    RA-e    lrld    _    _    _    _    RA-o    _    _    _    _
  _    RA-a    RA-s    _    _    _	_    _    _    RA-l    _    _    _
  _    RA-z    RA-x    RA-c  _    _    RA-n    _    _    _ _    _
  _    _    _              _              _    _    _ 
)

(deflayer numbers
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    1    2    3    4    5    6    7    8    9    0    -    =    bspc
  _    S-4    S-=    S-9  S-0    S-2    S-\    -    =      S--    S-8    '    ret
  _    S-1    S-3    S-[  S-]    S-`    S-7    [    ]    S-5    S-6    _
  _    _    _              _              _    _    _ 
)
;; _    $    +    \(    \)    @    |    -    =    \_    *    '    ret
;; _    !    #    {    }    ~    &    [    ]    %    ^    @mdf

(deflayer navigation ;; plus media
  XX    XX    XX    XX    XX    XX    XX    XX    XX    XX    XX    XX    XX    XX
  XX    XX    XX    XX    XX    XX    C-c   C-z	C-x   C-v  S-ins  XX    XX   XX
  XX    mute    vold  volu	XX    XX    left down   up   right   ret   XX    XX    
  XX    XX    XX    XX    XX    XX    home	pgdn pgup	end	  ins   XX
  XX    XX    XX              XX              XX    XX    XX 
)
;; S-ins; C-z: pase select, undo

(defalias ;; layers
  ;; lcrt (tap-hold-release 200 200 sldr lcrt)
  lsft (tap-hold-press 200 200 bspc lsft) ;;  left backspace
  rsft (tap-hold-press 200 200 S-0 rsft) ;; right bracket
;; tap shortcuts
  ;;pl (one-shot 500 (layer-while-held pl)) ;; I can use taht layer, idk if it is a great idea to bind it to ralt
  ;;ralt (tap-hold-release 200 200 @pl ralt) ;; TODO maybe double pl layer and make actions on hold
  apps (one-shot 500 (layer-while-held apps))
  lalt (tap-hold-release 200 200 @apps lalt)
;; hold shortcuts
  cap (tap-hold-press 200 200 esc (layer-while-held navigation)) ;; esc
  spc (tap-hold 200 200 spc (layer-while-held numbers))
  c (tap-hold 200 200 c (one-shot 800 (layer-while-held clip)))
  m (tap-hold 200 200 m (one-shot 800 (layer-while-held media)))
  u (tap-hold 200 200 u (one-shot 800 (layer-while-held url)))
  o (tap-hold 200 200 o (one-shot 800 (layer-while-held open)))
  i (tap-hold 200 200 i (one-shot 800 (layer-while-held AI)))
  z (tap-hold 200 200 z (one-shot 800 (layer-while-held task)))
;; multi doesn't work in as expected
  ;;i (tap-hold 200 200 i (multi (cmd notify-send "AI")(one-shot 800 (layer-while-held AI))))
 ;; enter (switch  ((and u i)) ret break)
  ;; spc (one-shot 500 (layer-while-held numbers))
)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;                  shortcuts                   ;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(defalias ;; symbols on hold
  grv (t! hold grv S-`)
  0 (t! hold 0 S-0)
  1 (t! hold 1 S-1)
  2 (t! hold 2 S-2)
  3 (t! hold 3 S-3)
  4 (t! hold 4 S-4)
  5 (t! hold 5 S-5)
  6 (t! hold 6 S-6)
  7 (t! hold 7 S-7)
  8 (t! hold 8 S-8)
  9 (t! hold 9 S-9)
  = (t! hold = S-=)
  - (t! hold - S--))
;; HOMEROW
(defalias
	alt_a (tap-hold 200 200 a lalt)
    met_s (tap-hold 200 200 s lmet)
    ctl_d (tap-hold 200 200 d lctl)
    sft_f (tap-hold 200 200 f lsft)
;; right hand
    sft_j (tap-hold 200 200 j rsft)
    ctl_k (tap-hold 200 200 k rctl)
    met_l (tap-hold 200 200 l rmet)
    alt_; (tap-hold 200 200 ; lalt)
)

(defchordsv2
;; can be only one
;; mod keys are not good for it - they overlaps with home row,
  (m ,) ret 100 first-release () ;; enter on m+,
  ;; ydotool doesn't work in hyprland
  (met sft x) (cmd ydotool click C0) 9000 first-release ()
  (l k x) (cmd ydotool click C0) 9000 first-release ()
  (met ctl x) (cmd ydotool click C1) 9000 first-release ()
  (l j x) (cmd ydotool click C1) 9000 first-release ()
  ;; has to be last, otherwise it will overlaps 3 key bindings!!
  (met x) @clip-primary 9000 first-release ()
  (l x) @clip-primary 9000 first-release ()
)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;                  APPLICATIONS                  ;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defalias ;; common apps scripts
  tab (tap-dance 200 (tab M-tab  A-tab C-tab)) ;; too many available actions
  trash (cmd sh -c r#"eval $(printf "$TERM_LT $TERM_LT_RUN" "trash" "gomi --restore")"#r)
  ;; without setsid or sh -c, apps will be terminated when kanata is killed
  rofi (cmd rofi -modi drun,keys,run -show drun -show-icons -sidebar-mode -monitor -4 -matching fuzzy)

  qu (cmd qu.clj menu)
  yt (cmd setsid mpv.lua -o) ;; playlists
  video (cmd setsid mpv.lua -o /home/miro/Videos)
  qb (cmd sh -c "$XDG_CONFIG_HOME/qutebrowser/userscripts/session.sh")
  pom (cmd sh -c "task sync && pomodoro.lua add -n")
  note (cmd sh -c r#"wezterm start --class note --cwd "$NOTE" -- nvim"#)
  idea (cmd setsid /home/miro/Ext/idea-IU-233.14015.106/bin/idea.sh)
  vifm (cmd sh -c r#"eval $(printf "$TERM_LT $TERM_LT_RUN" "vifm" "vifm")"#)
  news (cmd sh -c r#"scratchpad.clj -n news $(printf "$TERMINAL $TERM_RUN" "news" "newsboat")"#)
  quake (cmd sh -c r#"scratchpad.clj -n drop $(printf "$TERMINAL $TERM_RUN" "drop" "")"#)
  tw (cmd sh -c r#"task sync && scratchpad.clj -n task $(printf "$TERM_LT $TERM_LT_RUN" "task" "taskwarrior-tui")"#)
  chat (cmd sh -c r#"scratchpad.clj -n chat $(printf "$TERMINAL $TERM_RUN" "chat" "nchat")"#)
  off (cmd sh -c "rofi -show power-menu -modi power-menu:$ROFI/power.sh")
  kee (cmd setsid keecli.sh)
  todo (cmd todo.lua add)
  ;; aliases
clip-primary (cmd clipcat.clj primary --paste)

  audio (cmd audio.clj toggle)
  ;; old or change to wayland
  clip (cmd "/home/miro/.config/rofi/scripts/clipster/roficlip" )
  fm (cmd setsid pcmanfm )
  ;; scripts (cmd sh -c "$(ls ~/.bin | rofi -dmenu)")
)

(deflayermap (task)
	F1 (cmd notify-send task: "T-todo\nt-TW-tui\ni-add to inbox\nr-pom repeat\np-pom pause\nm-pom modify task\nl-pom menu\nd-pom add task\nn-pom notify\nk-gcal notify\na-gcal agenda\nc-gcal-add\ng-gamification\nf-timefx")
	i @todo
	t (t! hold @tw (cmd sh -c "todo.lua show")) ;; taskwarrior list in yad
	r (cmd sh -c "pomodoro.lua repeat -n")
	p (cmd sh -c "pomodoro.lua pause -n")
	m (cmd sh -c "pomodoro.lua modify")
	s (cmd sh -c "pomodoro.lua stop -n && task sync")
	l (cmd sh -c "pomodoro.lua menu -n")
	n (cmd sh -c "pomodoro.lua notify")
	d @pom
	g (cmd sh -c "java -jar ~/.local/bin/grywalizacja.jar")
	f (cmd sh -c "timefx")
	c (cmd sh -c "gcal-add.lua")
	k (cmd sh -c "gcal-show.sh")
	a (cmd sh -c "gcalcli --nocolor agenda --config-folder="/home/miro/.config/gcalcli"  | zenity --text-info")
  ___ _)

(deflayermap (url)
	F1 (cmd notify-send url: "(capital-10-urls)\nu-url menu\nm(M)-magnet\nf(F)-video\na(A)-audio dl\ny(Y)-yt dl\ng(G)-gallery-dl\nw(w)-wget\ns-speed reader\nr-read\nk(K)-kindle")
	u (cmd url.lua --menu --input)
	s (cmd url.lua --speed -n 1)
	r (cmd url.lua --read -n 1)
	;; maybe it should be tap-hold-press
	k (t! hold (cmd url.lua --kindle --email -n 1) (cmd url.lua --kindle --email -n 10))
	m (t! hold  (cmd url.lua --tor -n 1) (cmd url.lua --tor -n 10))
	f (t! hold  (cmd url.lua --mpvFullscreen -n 1) (cmd url.lua --mpvFullscreen -n 10))
	a (t! hold  (cmd url.lua --dlAudio -n 1) (cmd url.lua --dlAudio -n 10))
	g (t! hold  (cmd url.lua --gallery -n 1) (cmd url.lua --gallery -n 10))
	y (t! hold  (cmd url.lua --dlVideo -n 1) (cmd url.lua --dlVideo -n 10))
	w (t! hold  (cmd url.lua --wget -n 1) (cmd url.lua --wget -n 10))
  ___ _)

(deflayermap (open)
	F1 (cmd notify-send search: "(capital-clipboard)\nm-menu input\np-menu primary\nc-menu clip\ng(G)-google\ny(Y)-yt\na(A)-maps\nw(W)-wiki\nd(D)-diki\nl(L)-deepL\nr(R)-translator\np(P)-pl-en trans\nt(T)-en-pl trans\nm(M)-tor\ni-cheatsh input\nk(K)-cheatsh")
	o (cmd search.lua --menu -input)
	p (cmd search.lua --menu -p) 
	c (cmd search.lua --menu -c)
	g (t! hold (cmd search.lua --google -p) (cmd search.lua --google -c))
	y (t! hold (cmd search.lua --yt -p) (cmd search.lua --yt -c))
	a (t! hold (cmd search.lua --maps -p) (cmd search.lua --maps -c))
	w (t! hold (cmd search.lua --wiki -p) (cmd search.lua --wiki -c))
	d (t! hold (cmd search.lua --diki -p) (cmd search.lua --diki -c))
	l (t! hold (cmd search.lua --deepl -p) (cmd search.lua --deepl -c))
	r (t! hold (cmd search.lua --translator -p) (cmd search.lua --translator -c))
	e (t! hold (cmd search.lua --plen -p) (cmd search.lua --plen -c))
	t (t! hold (cmd search.lua --enpl -p) (cmd search.lua --enpl -c))
	i (cmd search.lua --cheat --input)
	k (t! hold (cmd search.lua --cheat -p) (cmd search.lua --cheat -c))
  ___ _)

(deflayermap (media) ;; add music player
F1 (cmd notify-send media: "v-videos\ny-yt\ny-playlists\ns-ytsearch\nc-ytsearch clip\na-yt-account\nn-newsboat\nq-qb")
  n (cmd sh -c "db-search.clj --newsboat")
  q (cmd sh -c "db-search.clj --qutebrowser")
  y @yt
  v @video
  ;;s (cmd sh -c "mpv.lua -y") ;; slower
  s (cmd sh -c "yt.clj search --input") ;; youtube search
  c (cmd sh -c "yt.clj --clip")
  a (cmd sh -c "yt.clj playlist --channel")
  ___ _)

;; TODO add ollama on hold
(deflayermap (AI)
	F1 (cmd notify-send AI: "i-ask\nt-ask abou text\np-ask about text-prim\nl-action list\ns-summary\na-summary in adoc\ng-grammar\nx-explain grammar\nr-trans to pl\ne-trans to en")
	i (cmd chat.clj ask -o scratchpad) ;; ask question
	t (cmd chat.clj text -o scratchpad) ;; ask about text
	p (cmd chat.clj text -o scratchpad --primary) ;; ask about text from primary selection
	l (cmd chat.clj action -o scratchpad --action-list) ;; action menu
	a (cmd chat.clj action -o scratchpad -t summary-adoc)
	s (cmd chat.clj action -o scratchpad -t summary-short)
	g (cmd chat.clj action -o scratchpad -t grammar)
	x (cmd chat.clj action -o scratchpad -t grammar-explain)
	r (cmd chat.clj action -o scratchpad -t translate-to-polish)
	e (cmd chat.clj action -o scratchpad -t translate-to-english)
  ___ _)

(deflayermap (clip)
	F1 (cmd notify-send clip: "p-(prim)selection\nr-remove clip\nj-join clip\nn-next clip\ns(S)-note from clip/sel\ni-note from clip join\nw -write note")
	p @clip-primary
	j (cmd clipcat.clj join --input)
	4 (cmd clipcat.clj join --number 4)
	m (cmd clipcat.clj menu --paste)
	r (cmd clipcat-menu remove)
	;;e (cmd bash -c "clipcat-menu edit") ;; not useful, also it doesn't work
	n (cmd clipcat.clj clip --previous --paste)
	;; maybe better for sequence 
	s (t! hold (cmd note.lua clip 1) (cmd note.lua sel 1)) ;; selection on hold
	i (cmd note.lua clip) ;; input for the number of copied elements
	w (cmd note.lua write)
  ___ _)

