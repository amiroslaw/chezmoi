#!/bin/bash
set -e

LOCAL_BIN_DIR="$HOME/.local/bin"
TMP="$HOME/tmp-chezmoi"
mkdir -p "$TMP"
mkdir -p "$LOCAL_BIN_DIR"
sudo bash < <(curl -s https://raw.githubusercontent.com/babashka/babashka/master/install)

echo "🔨 install clipcat..."
sudo zypper --no-gpg-checks install -y $TMP/clipcat.rpm

curl -fsSL https://gomi.dev/install | bash
mv "$HOME/bin/gomi" "$LOCAL_BIN_DIR"

# fasder
FASDER_DIR="$TMP/fasder"
FASDER_FILE="fasder"
# mkdir -p "$FASDER_DIR"

echo "🔨 Building fasder project in $FASDER_DIR..."
cd "$FASDER_DIR"
go build
cp -v --update=none "$FASDER_FILE" "$LOCAL_BIN_DIR/fasder"
echo "✅ Build complete and copied - fasder."

