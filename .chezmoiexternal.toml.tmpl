["tmp-chezmoi/fasder"]
	type = "git-repo" 
	url = "https://github.com/wyne/fasder.git"

[".config/zgenom"]
	type = "git-repo" 
	url = "https://github.com/jandamm/zgenom.git"

["tmp-chezmoi/clipcat.rpm"]
	type = "file" 
    url = {{ gitHubLatestReleaseAssetURL "xrelkd/clipcat" "clipcat-*.x86_64.rpm" | quote }}

[".local/bin/soulseek-rs"]
    type = "archive-file"
    url = {{ gitHubLatestReleaseAssetURL "michel/soulseek-rs" "soulseek-rs-v*-x86_64-unknown-linux-musl.tar.gz" | quote }}
    executable = true
    path = "soulseek-rs"
    refreshPeriod = "168h"

[".local/bin/opencode"]
    type = "archive-file"
    url = {{ gitHubLatestReleaseAssetURL "anomalyco/opencode" "opencode-linux-x64.tar.gz" | quote }}
    executable = true
    path = "opencode"
    refreshPeriod = "168h"

